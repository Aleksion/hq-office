# HQ Office configuration. KEY=VALUE per line; lines starting with # are ignored.
# An empty value means "use the default". Restart after a change:
#   herdr plugin action invoke hq-office.reload

# The herdr agent name of your HQ lane: the agent that asks you questions and
# receives your answers and notes. Run `herdr agent list` to see the names.
# If left empty, the server falls back to an agent named "hq".
HUD_HQ_AGENT=

# Your name, shown on the desk sign in the room.
HUD_OWNER=

# Port and address the server listens on. Defaults: 4747 and 127.0.0.1.
# Keep the host on 127.0.0.1 unless you know why you want otherwise.
HUD_PORT=
HUD_HOST=

# GitHub repo (owner/repo) used to link lanes to their pull requests.
HUD_GITHUB_REPO=

# Linear workspace slug used to link lanes to their issues.
HUD_LINEAR_WORKSPACE=

# Name of this machine in the room. Default: local.
HUD_LOCAL_MACHINE=

# Comma-separated herdr machines to poll for agents and to sample for CPU and memory.
# Use the machine labels from `herdr machine list`. Not every computer has the same
# machines, so list only the ones you have. Remote machines need SSH access from
# this computer, using the target herdr shows. Default: just this machine.
HUD_MACHINES=

# Path to the herdr binary. Default: herdr, found on PATH.
HERDR_BIN=

# Where the database and uploaded images live. The plugin sets this to its
# state directory, so your answers survive reinstalls. Leave empty.
HUD_DATA_DIR=
